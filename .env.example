# The existing public Supabase Auth project is configured in src/config/public-supabase.ts.
# Sign in is required; comparison and per-account device saving then work locally.
# Optional public recovery endpoint for the deployed stateless Edge Function.
# Example: http://127.0.0.1:54321/functions/v1/recovery
VITE_RECOVERY_API_URL=
# Never prefix provider secrets or service-role keys with VITE_.

# Optional overrides for a separate Supabase development project. Both are public browser values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
