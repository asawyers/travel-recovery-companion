# Loopback endpoint only. Never target hosted recovery or supply service/API keys.
RECOVERY_API_URL=http://127.0.0.1:54321/functions/v1/recovery
# A current signed-in user access token for the same Supabase project as the backend.
# Keep the real token only in the ignored .env.integration.local file; never commit it.
# Missing/forged tokens are tested separately and must return 401.
RECOVERY_ACCESS_TOKEN=
